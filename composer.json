{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cosamey/bumble",
    "type": "project",
    "description": "Playful, opinionated starter kit for Laravel projects.",
    "keywords": ["laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "cosamey/spine": "^1.2.0",
        "laravel/framework": "^13.39.0",
        "laravel/head": "^0.2.2",
        "laravel/nightwatch": "^1.30.6",
        "laravel/tinker": "^3.0.2",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "livewire/flux": "^2.21.0",
        "livewire/livewire": "^4.4.8",
        "spatie/browsershot": "^5.4.2",
        "spatie/laravel-activitylog": "^5.1.3",
        "spatie/laravel-backup": "^10.3.3",
        "spatie/laravel-data": "^4.23.1",
        "spatie/laravel-medialibrary": "^11.23.11",
        "spatie/laravel-pdf": "^2.14.0",
        "spatie/laravel-sluggable": "^4.0.6",
        "spatie/laravel-translatable": "^6.15.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.13.2",
        "laravel/boost": "^2.10.4",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.4",
        "pestphp/pest-plugin-laravel": "^5.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "analyse": "phpstan analyse --ansi",
        "check": [
            "@analyse",
            "@format:check",
            "@test"
        ],
        "format": [
            "bun run format",
            "pint"
        ],
        "format:check": [
            "bun run format:check",
            "pint --test"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test --compact"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
